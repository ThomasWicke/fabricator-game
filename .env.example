# Copy to .env (gitignored). `partykit dev` loads .env automatically into
# room env; the eval script (scripts/eval-compiler.ts) reads it too.
#
# Dev default provider is Gemini free tier — only GOOGLE_API_KEY is needed.
# Get one at https://aistudio.google.com/ (free, no card).
GOOGLE_API_KEY=

# Optional quality anchor for the eval comparison (claude-sonnet-5 / haiku).
# Leave empty to skip Anthropic entirely.
ANTHROPIC_API_KEY=

# ── Self-hosted backend (the Mac mini) — free, tried before any cloud key ──
# Ollama server for spec compilation. Localhost in dev; the Cloudflare
# Tunnel hostname (https://ollama.<domain>) for the deployed Worker.
LOCAL_AI_URL=
# ComfyUI server for body sprites (http://127.0.0.1:8188 in dev).
LOCAL_IMAGE_URL=
# Auth for both, empty on localhost. Either a Cloudflare Access service
# token as "id:secret", or a plain bearer token for a reverse proxy.
LOCAL_AI_TOKEN=
# Override the Ollama model (default: qwen3-vl:8b).
LOCAL_COMPILER_MODEL=

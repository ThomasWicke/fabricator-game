{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  // Client + the isomorphic modules it shares with the Worker. The Worker
  // itself is checked by tsconfig.worker.json — its Cloudflare runtime
  // globals conflict with DOM lib, so the two can't share one project.
  "include": ["client/src/**/*", "shared/**/*", "party/protocol.ts", "party/designs.ts"]
}
